{
  "opencollection": "1.0.0",
  "info": {
    "name": "ArchiMate Model Exchange Elements API",
    "version": "3.2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Elements",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "ArchiMate List Elements",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.archimate-tools.com/v1/models/:modelId/elements",
            "params": [
              {
                "name": "modelId",
                "value": "model-001",
                "type": "path",
                "description": "Model identifier"
              },
              {
                "name": "layer",
                "value": "Application",
                "type": "query",
                "description": "Filter by architecture layer"
              },
              {
                "name": "type",
                "value": "ApplicationComponent",
                "type": "query",
                "description": "Filter by element type"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List all architecture elements in an ArchiMate model."
        }
      ]
    }
  ],
  "bundled": true
}